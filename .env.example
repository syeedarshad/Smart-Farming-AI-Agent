# ─────────────────────────────────────────────────────────────────────────────
# Smart Farming AI – environment variable template
# Copy this file to .env and fill in your actual values.
#
# SECURITY RULES:
#   - NEVER commit .env to version control (it is already in .gitignore).
#   - NEVER paste API keys or tokens into chat, logs or issue trackers.
#   - Use strong, randomly-generated values for all secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ──────────────────────────────────────────────────────────────
# Options:
#   demo          No credentials needed. Answers come from the local knowledge base.
#   ibm_granite   Real IBM Granite via watsonx.ai. Requires credentials below.
LLM_PROVIDER=demo

# ── IBM watsonx.ai credentials ─────────────────────────────────────────────
# Required only when LLM_PROVIDER=ibm_granite.
# Obtain from: https://cloud.ibm.com → Resource list → Watson Machine Learning

# Your IBM Cloud API key (IAM → API keys)
WATSONX_API_KEY=your_api_key_here

# Your watsonx.ai project ID (found in the project settings page)
WATSONX_PROJECT_ID=your_project_id_here

# watsonx.ai service endpoint — change the region prefix if your service
# is in a different region (eu-de, eu-gb, jp-tok, au-syd, etc.)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID — use the exact ID shown in the watsonx.ai model catalogue.
# Use the model your watsonx.ai Lite project supports. Check your project's
# available models at: https://dataplatform.cloud.ibm.com → your project → Assets
GRANITE_MODEL_ID=ibm/granite-4-h-small


# IBM Cloud IAM token endpoint — change only if using a private cloud / VPC setup.
IBM_CLOUD_IAM_URL=https://iam.cloud.ibm.com/identity/token

# ── Application settings ───────────────────────────────────────────────────
# Application display name (shown in the Streamlit sidebar and page titles)
APP_NAME=Smart Farming AI-Agent

# Environment tag — used for logging and conditional behaviour
# Options: development | staging | production
APP_ENV=development

# Streamlit server port (default 8501 — matches the standard Streamlit default)
APP_PORT=8501

# Enable verbose debug logging (true | false)
APP_DEBUG=false
